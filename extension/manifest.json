{
  "manifest_version": 3,
  "name": "Screen to Ctrl+F",
  "version": "0.4.0",
  "description": "Receives a booking ID from the screenshot bridge and searches only the active or specifically targeted open Google Sheet.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://docs.google.com/spreadsheets/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Screen to Ctrl+F",
    "default_popup": "popup.html"
  }
}